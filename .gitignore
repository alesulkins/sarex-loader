# Customer repository: runtime, routing configuration and launchers only.
# Everything else remains local unless explicitly added to this allowlist.
/*
!/.gitignore
!/.gitattributes
!/pyproject.toml
!/MANIFEST.in
!/customer.routes.toml
!/account.toml
!/start.py
!/start.bat
!/start.command
!/setup.bat
!/start-upload.bat
!/start-fill-urls.bat
!/src/
/src/*
!/src/sarex_loader/
/src/sarex_loader/*
!/src/sarex_loader/*.py
!/src/sarex_loader/profile-routes.toml
!/src/sarex_loader/browser_extension.js

# Customer inputs and runtime state remain local. account.toml is explicitly distributed.
__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
*.xlsx
*.xls
*.xlsm
*.pdf
*.docx
*.log
*.bak
.DS_Store

# Delivery documentation and synthetic platform checks.
!/README.md
!/RELEASE_NOTES.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/platform-validation.yml
!/tools/
/tools/*
!/tools/mock_demo.py
!/tools/platform_probe.py
!/tools/build_release.py
!/tests/
/tests/*
!/tests/__init__.py
!/tests/test_windows_native.py
!/tests/windows_journal_probe.py

!/tools/check_release.py
