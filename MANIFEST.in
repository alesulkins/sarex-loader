include pyproject.toml MANIFEST.in customer.routes.toml
include start.py start.bat start.command setup.bat start-upload.bat start-fill-urls.bat
recursive-include src/sarex_loader *.py
include src/sarex_loader/profile-routes.toml src/sarex_loader/browser_extension.js
prune tests
prune docs
prune data
prune input
prune inputs
prune output
prune outputs
prune reports
prune logs
prune journal
global-exclude *.md *.xlsx *.xls *.xlsm *.pdf *.docx *.sqlite* *.db *.log
global-exclude *.pem *.key .env .env.* *.local.toml settings.toml
global-exclude __pycache__ *.py[cod]
